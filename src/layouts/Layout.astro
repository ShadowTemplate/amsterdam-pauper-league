---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CardPreviewPopup from "@/components/CardPreviewPopup.astro";
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Amsterdam Pauper League",
  description = "The largest Magic: The Gathering™ Pauper tournament series in the Netherlands",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&family=Geist+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-full flex flex-col bg-background text-foreground">
    <Header />
    <slot />
    <Footer />
    <CardPreviewPopup />
  </body>
</html>
