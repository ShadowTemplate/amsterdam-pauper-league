---
// A one-off animation of the landing burst when the page opens: ripples run
// outward along every ray, away from the figure, as if the waves were
// propagating. Each ray stays in place; its outline is bent by a wave
// travelling from the tip towards the edge of the window. The ripples swell
// in, travel for DURATION, and fade out back to the exact artwork.
// Skipped for visitors who prefer reduced motion, or when the page doesn't
// open at the top (e.g. /#standings).
//
// Self-contained on purpose: to turn it off, remove <WaveWiggle /> from the
// page.
---

<script>
  const DURATION = 2000; // ms
  const AMPLITUDE = 32; // peak sideways bend, in artwork units (artboard is 2550 wide)
  const WAVELENGTH = 520; // distance between ripple crests along a ray (artwork units)
  const RIPPLES = 3; // wavelengths each ripple travels outward during the animation
  const CALM_TIP = 450; // distance from a ray's tip over which the ripples fade in
  const CENTER = [1234.5, 1265.3]; // the burst's centre in artwork units
  const MAX_SEGMENT = 40; // longest straight piece of outline while bending (artwork units)

  type Ray = { el: SVGPathElement; points: number[]; normal: [number, number]; along: number[]; fade: number[] };

  const smoothstep = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));

  function prepare(el: SVGPathElement): Ray {
    // the generator writes rays as "M x yL x y…Z" polygons, simplified: add
    // points along long straight stretches so the bend stays a smooth curve
    const raw = (el.getAttribute("d") ?? "").match(/-?\d+(\.\d+)?/g)!.map(Number);
    const points: number[] = [];
    for (let i = 0; i < raw.length; i += 2) {
      const [x0, y0] = [raw[i], raw[i + 1]];
      const [x1, y1] = [raw[(i + 2) % raw.length], raw[(i + 3) % raw.length]];
      const steps = Math.max(1, Math.ceil(Math.hypot(x1 - x0, y1 - y0) / MAX_SEGMENT));
      for (let k = 0; k < steps; k++) points.push(x0 + ((x1 - x0) * k) / steps, y0 + ((y1 - y0) * k) / steps);
    }
    let mx = 0;
    let my = 0;
    for (let i = 0; i < points.length; i += 2) {
      mx += points[i] - CENTER[0];
      my += points[i + 1] - CENTER[1];
    }
    const len = Math.hypot(mx, my);
    const axis: [number, number] = [mx / len, my / len]; // outward direction of the ray
    const normal: [number, number] = [-axis[1], axis[0]];
    const along: number[] = [];
    for (let i = 0; i < points.length; i += 2) {
      along.push((points[i] - CENTER[0]) * axis[0] + (points[i + 1] - CENTER[1]) * axis[1]);
    }
    const tip = Math.min(...along);
    // calm at the tip near the figure, growing towards the outside
    const fade = along.map((s) => smoothstep((s - tip) / CALM_TIP) * Math.min(1, 0.6 + (s - tip) / 3000));
    return { el, points, normal, along, fade };
  }

  function draw(ray: Ray, bend: (s: number) => number, weight: number) {
    const { points, normal, along, fade } = ray;
    let d = "";
    for (let i = 0, j = 0; i < points.length; i += 2, j++) {
      const off = weight * fade[j] * bend(along[j]);
      d += `${j ? "L" : "M"}${(points[i] + normal[0] * off).toFixed(1)} ${(points[i + 1] + normal[1] * off).toFixed(1)}`;
    }
    ray.el.setAttribute("d", d + "Z");
  }

  const paths = [...document.querySelectorAll<SVGPathElement>(".burst-rays path")];
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (paths.length && !calm && scrollY < innerHeight / 2) {
    const original = paths.map((p) => p.getAttribute("d"));
    const rays = paths.map(prepare);
    // the clock starts on the first drawn frame, not while the page is still
    // loading, so the start isn't swallowed by a slow first frame
    let start: number | null = null;
    const frame = (now: number) => {
      start ??= now;
      const t = Math.min((now - start) / DURATION, 1);
      // swell in and fade out smoothly: no jump at either end
      const weight = AMPLITUDE * Math.sin(Math.PI * t) ** 2;
      // crests move outward: phase decreases along the ray as time passes
      const travelled = RIPPLES * WAVELENGTH * t;
      const bend = (s: number) => Math.sin((2 * Math.PI * (s - travelled)) / WAVELENGTH);
      for (const ray of rays) draw(ray, bend, weight);
      if (t < 1) requestAnimationFrame(frame);
      else paths.forEach((p, i) => p.setAttribute("d", original[i]!)); // exact artwork again
    };
    requestAnimationFrame(frame);
  }
</script>
