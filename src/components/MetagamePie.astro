---
import type { EventMetaEntry } from "@/types";

interface Props {
  meta: EventMetaEntry[];
  title?: string;
}

const { meta, title = "Metagame" } = Astro.props;

// Metagame pie: the top archetypes each get their own slice/color; everything
// past that is merged into a single "Other" slice. This order (top 8 = the
// documented dark-theme categorical palette; 9-15 chosen by brute-force search
// over orderings) is the one arrangement of these 15 hues where every adjacent
// pair still clears the dataviz CVD-separation gate (worst adjacent ΔE 8.4) —
// re-run scripts/validate_palette.js from the dataviz skill before reordering
// or swapping any of these hexes. The legend below keeps every archetype as
// its own labeled, linked row — only the pie geometry groups them.
const META_TOP_N = 15;
const META_COLORS = [
  "#3987e5", // blue
  "#d95926", // orange
  "#199e70", // aqua
  "#c98500", // yellow
  "#d55181", // magenta
  "#008300", // green
  "#9085e9", // violet
  "#e66767", // red
  "#8e61d1", // indigo
  "#279b55", // teal
  "#d161bb", // orchid
  "#889e2e", // yellow-green
  "#af53c6", // purple
  "#559b27", // lime-green
  "#2e9cb8", // cyan
];
const META_OTHER_COLOR = "#5b6472"; // neutral gray shared by every archetype past the top 15

const sortedMeta = [...meta].sort((a, b) => b.count - a.count);
const metaTotal = sortedMeta.reduce((sum, m) => sum + m.count, 0);
const metaTop = sortedMeta.slice(0, META_TOP_N);
const metaRest = sortedMeta.slice(META_TOP_N);
const metaOtherCount = metaRest.reduce((sum, m) => sum + m.count, 0);

// Donut geometry — arcs computed at build time; only the hover pop/tooltip is client JS.
const PIE_SIZE = 220;
const PIE_CX = 110;
const PIE_CY = 110;
const PIE_INNER_R = 55;
const PIE_OUTER_R = 95;
const PIE_GAP = 0.02;

function polarPoint(r: number, angle: number): [number, number] {
  return [PIE_CX + r * Math.cos(angle), PIE_CY + r * Math.sin(angle)];
}

function arcPath(start: number, end: number): string {
  const [ox1, oy1] = polarPoint(PIE_OUTER_R, start);
  const [ox2, oy2] = polarPoint(PIE_OUTER_R, end);
  const [ix2, iy2] = polarPoint(PIE_INNER_R, end);
  const [ix1, iy1] = polarPoint(PIE_INNER_R, start);
  const largeArc = end - start > Math.PI ? 1 : 0;
  return `M${ox1},${oy1}A${PIE_OUTER_R},${PIE_OUTER_R},0,${largeArc},1,${ox2},${oy2}L${ix2},${iy2}A${PIE_INNER_R},${PIE_INNER_R},0,${largeArc},0,${ix1},${iy1}Z`;
}

// One slice per top archetype, plus one merged slice for the rest. `sliceIndex`
// ties a slice back to the legend rows that belong to it (see below).
const pieSourceSlices = [
  ...metaTop.map((m, i) => ({
    label: m.archetype,
    slug: m.archetypeSlug,
    count: m.count,
    percentage: m.percentage,
    color: META_COLORS[i],
    share: metaTotal > 0 ? m.count / metaTotal : 0,
  })),
  ...(metaOtherCount > 0
    ? [
        {
          label: `Other (${metaRest.length} archetypes)`,
          slug: null, // no single archetype page to link to
          count: metaOtherCount,
          percentage: `${((metaOtherCount / metaTotal) * 100).toFixed(2)}%`,
          color: META_OTHER_COLOR,
          share: metaTotal > 0 ? metaOtherCount / metaTotal : 0,
        },
      ]
    : []),
];

let metaCursor = -Math.PI / 2;
const pieSlices = pieSourceSlices.map((seg, i) => {
  const sweep = seg.share * 2 * Math.PI;
  const gap = sweep > PIE_GAP * 2 ? PIE_GAP : 0;
  const start = metaCursor + gap;
  const end = metaCursor + sweep - gap;
  const mid = (start + end) / 2;
  metaCursor += sweep;
  return {
    ...seg,
    sliceIndex: i,
    d: arcPath(start, end),
    tx: +(Math.cos(mid) * 8).toFixed(2),
    ty: +(Math.sin(mid) * 8).toFixed(2),
  };
});
const META_OTHER_SLICE_INDEX = META_TOP_N; // the merged slice, if present, is always last

// Legend rows: every archetype, individually labeled/linked, tagged with the
// pie slice it should pop when hovered (its own for the top N, the shared
// "Other" slice for everything else).
const legendItems = sortedMeta.map((m, i) => ({
  label: m.archetype,
  slug: m.archetypeSlug,
  count: m.count,
  percentage: m.percentage,
  color: i < META_TOP_N ? META_COLORS[i] : META_OTHER_COLOR,
  legendIndex: i,
  sliceIndex: i < META_TOP_N ? i : META_OTHER_SLICE_INDEX,
}));
// Two columns, filled top-to-bottom (most → least popular) then wrapping to
// the next column — grid-flow-col with an explicit row count, same approach
// pauperformance.com uses, rather than the default row-major reading order.
const META_LEGEND_ROWS = Math.max(1, Math.ceil(legendItems.length / 2));
---

{sortedMeta.length > 0 && (
  <section class="mb-8">
    <h2 class="text-xl font-semibold mb-4">{title}</h2>

    <div class="bg-card border border-border rounded-xl p-5">
      <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start">
        <div class="w-full max-w-56 sm:w-56 shrink-0" id="meta-pie-wrap">
          <svg viewBox={`0 0 ${PIE_SIZE} ${PIE_SIZE}`} class="w-full h-auto overflow-visible">
            {pieSlices.map((s) => (
              <path
                d={s.d}
                fill={s.color}
                class="meta-pie-slice"
                data-slice-index={s.sliceIndex}
                data-tx={s.tx}
                data-ty={s.ty}
                data-name={s.label}
                data-value={s.percentage}
                data-count={s.count}
                data-href={s.slug ? `/archetypes/${s.slug}` : undefined}
              ></path>
            ))}
          </svg>
          <p class="text-sm text-muted-foreground text-center mt-2">
            {sortedMeta.length} archetypes in {metaTotal} decks
          </p>
        </div>

        <div
          class="flex-1 min-w-0 grid grid-cols-1 sm:grid-cols-2 sm:grid-flow-col gap-x-4 gap-y-1 w-full"
          style={`grid-template-rows: repeat(${META_LEGEND_ROWS}, minmax(0, 1fr));`}
        >
          {legendItems.map((item) => (
            <div
              class="flex items-center gap-2 min-w-0 rounded px-1 -mx-1 py-0.5 meta-legend-item"
              data-legend-index={item.legendIndex}
              data-slice-index={item.sliceIndex}
            >
              <span class="w-2.5 h-2.5 rounded-full shrink-0" style={`background-color: ${item.color};`}></span>
              <a
                href={`/archetypes/${item.slug}`}
                class="text-sm truncate hover:underline underline-offset-4 min-w-0 flex-1"
              >
                {item.label}
              </a>
              <span class="text-xs text-muted-foreground shrink-0">{item.percentage} ({item.count})</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div id="meta-pie-tooltip" class="meta-pie-tooltip" hidden>
      <p class="meta-pie-tooltip-name"></p>
      <p class="meta-pie-tooltip-value"></p>
    </div>
  </section>
)}

<style>
  .meta-pie-slice {
    transition: transform 0.15s ease;
    cursor: default;
  }

  .meta-pie-slice[data-href] {
    cursor: pointer;
  }

  .meta-legend-item {
    cursor: default;
    transition: background-color 0.15s ease;
  }

  .meta-legend-item.is-active {
    background-color: var(--muted);
  }

  .meta-pie-tooltip {
    position: fixed;
    z-index: 100;
    pointer-events: none;
    top: 0;
    left: 0;
    background: var(--popover);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.75rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.4);
  }

  .meta-pie-tooltip-name {
    font-weight: 600;
    color: var(--foreground);
    font-size: 0.875rem;
  }

  .meta-pie-tooltip-value {
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }
</style>

<script>
  const pieWraps = document.querySelectorAll<HTMLElement>("[id^='meta-pie-wrap']");

  pieWraps.forEach((wrap) => {
    const section = wrap.closest("section");
    if (!section) return;

    const slices = section.querySelectorAll<SVGPathElement>(".meta-pie-slice");
    const legendItems = section.querySelectorAll<HTMLElement>(".meta-legend-item");
    const tooltip = section.querySelector<HTMLElement>(".meta-pie-tooltip");
    const tooltipName = tooltip?.querySelector<HTMLElement>(".meta-pie-tooltip-name");
    const tooltipValue = tooltip?.querySelector<HTMLElement>(".meta-pie-tooltip-value");

    // Popping a slice highlights every legend row that maps to it (the shared
    // "Other" slice can map to many rows); hovering a single legend row instead
    // highlights only itself, while still popping its (possibly shared) slice.
    function popSlice(sliceIndex: string) {
      slices.forEach((slice) => {
        if (slice.dataset.sliceIndex === sliceIndex) {
          slice.setAttribute("transform", `translate(${slice.dataset.tx}, ${slice.dataset.ty})`);
        } else {
          slice.removeAttribute("transform");
        }
      });
    }

    function setActiveFromSlice(sliceIndex: string) {
      popSlice(sliceIndex);
      legendItems.forEach((item) => {
        item.classList.toggle("is-active", item.dataset.sliceIndex === sliceIndex);
      });
    }

    function setActiveFromLegend(legendIndex: string, sliceIndex: string) {
      popSlice(sliceIndex);
      legendItems.forEach((item) => {
        item.classList.toggle("is-active", item.dataset.legendIndex === legendIndex);
      });
    }

    function clearActive() {
      slices.forEach((slice) => slice.removeAttribute("transform"));
      legendItems.forEach((item) => item.classList.remove("is-active"));
      if (tooltip) tooltip.hidden = true;
    }

    function positionTooltip(x: number, y: number) {
      if (!tooltip) return;
      const margin = 14;
      const rect = tooltip.getBoundingClientRect();
      let left = x + margin;
      if (left + rect.width > window.innerWidth - margin) {
        left = x - rect.width - margin;
      }
      let top = y - rect.height - margin;
      if (top < margin) top = y + margin;
      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${top}px`;
    }

    slices.forEach((slice) => {
      slice.addEventListener("mouseenter", (e) => {
        setActiveFromSlice(slice.dataset.sliceIndex ?? "");
        if (tooltip && tooltipName && tooltipValue) {
          tooltipName.textContent = slice.dataset.name ?? "";
          tooltipValue.textContent = `${slice.dataset.value ?? ""} (${slice.dataset.count ?? ""})`;
          tooltip.hidden = false;
          positionTooltip((e as MouseEvent).clientX, (e as MouseEvent).clientY);
        }
      });
      slice.addEventListener("mousemove", (e) => {
        positionTooltip((e as MouseEvent).clientX, (e as MouseEvent).clientY);
      });
      slice.addEventListener("mouseleave", clearActive);
      slice.addEventListener("click", () => {
        const href = slice.dataset.href;
        if (href) window.location.href = href;
      });
    });

    legendItems.forEach((item) => {
      item.addEventListener("mouseenter", () =>
        setActiveFromLegend(item.dataset.legendIndex ?? "", item.dataset.sliceIndex ?? ""),
      );
      item.addEventListener("mouseleave", clearActive);
    });
  });
</script>
