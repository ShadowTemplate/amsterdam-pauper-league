---
import { CURRENT_SEASON_YEAR } from "@/lib/current-season";

const year = new Date().getFullYear();

const footerLinks = [
  { href: `/seasons/${CURRENT_SEASON_YEAR}`, label: "Seasons" },
  { href: `/events/${CURRENT_SEASON_YEAR}`, label: "Events" },
  { href: "/players", label: "Players" },
  { href: "/archetypes", label: "Archetypes" },
  { href: "/decks", label: "Decks" },
  { href: "/faq", label: "FAQ" },
];
---

<footer class="mt-auto bg-apl-orange text-apl-navy">
  <div class="container mx-auto max-w-6xl px-6 py-6 flex flex-col gap-5">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-5">
      <a href="/" class="flex items-center hover:opacity-80 transition-opacity shrink-0" aria-label="Amsterdam Pauper League home">
        <img src="/apl-logo.svg" alt="Amsterdam Pauper League" width="161" height="56" class="h-10 w-auto" />
      </a>

      <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          footerLinks.map((link) => (
            <a
              href={link.href}
              class="text-apl-navy hover:text-apl-yellow hover:underline underline-offset-4 transition-colors rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-apl-navy focus-visible:ring-offset-2 focus-visible:ring-offset-apl-orange"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex gap-4 shrink-0">
        <a
          href="https://www.instagram.com/dutchpauperleague"
          target="_blank"
          rel="noopener noreferrer"
          class="text-apl-navy/70 hover:text-apl-navy transition-colors hidden"
          aria-label="Instagram"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
          </svg>
        </a>
        <a
          href="https://chat.whatsapp.com/JjxLWoWOZrIIkuRFoWfV0D"
          target="_blank"
          rel="noopener noreferrer"
          class="text-apl-navy/70 hover:text-apl-navy transition-colors"
          aria-label="WhatsApp"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pt-6 border-t border-apl-navy/10 text-xs text-apl-navy/60">
      <p>&copy; {year} Amsterdam Pauper League</p>
      <a href="/privacy-policy" class="hover:text-apl-navy hover:underline underline-offset-4 transition-colors">
        Privacy Policy
      </a>
    </div>
  </div>
</footer>
