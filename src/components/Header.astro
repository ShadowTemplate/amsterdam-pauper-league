---
import { CURRENT_SEASON_YEAR } from "@/lib/current-season";

const navLinksLeft = [
  { href: `/seasons/${CURRENT_SEASON_YEAR}`, label: "Seasons" },
  { href: `/events/${CURRENT_SEASON_YEAR}`, label: "Events" },
  { href: "/players", label: "Players" },
];

const navLinksRight = [
  { href: "/archetypes", label: "Archetypes" },
  { href: "/decks", label: "Decks" },
  { href: "/faq", label: "FAQ" },
];

const navLinks = [...navLinksLeft, ...navLinksRight];
---

<header class="sticky top-0 z-50 w-full bg-apl-navy border-b border-white/10">
  <div class="container mx-auto flex h-20 max-w-screen-2xl items-center justify-between px-4 md:grid md:grid-cols-[1fr_auto_1fr]">
    <!-- Desktop nav (left) -->
    <nav class="hidden md:flex items-center gap-6 text-base">
      {
        navLinksLeft.map((link) => (
          <a
            href={link.href}
            class="text-apl-yellow hover:text-apl-orange hover:underline underline-offset-4 transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Logo (center) -->
    <a href="/" class="flex items-center hover:opacity-80 transition-opacity">
      <img src="/apl-logo-white.svg" alt="Amsterdam Pauper League" width="161" height="56" class="h-14 w-auto" />
    </a>

    <!-- Desktop nav (right) -->
    <nav class="hidden md:flex items-center justify-end gap-6 text-base">
      {
        navLinksRight.map((link) => (
          <a
            href={link.href}
            class="text-apl-yellow hover:text-apl-orange hover:underline underline-offset-4 transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Mobile menu button (right, shown only on mobile) -->
    <div class="flex items-center justify-end gap-2 md:hidden">
      <button
        id="mobile-menu-btn"
        aria-label="Open menu"
        class="p-2 rounded-md hover:bg-white/10 transition-colors text-white/80 hover:text-white"
      >
        <svg
          id="menu-icon-open"
          class="h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <svg
          id="menu-icon-close"
          class="hidden h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-apl-navy">
    <nav class="container mx-auto max-w-screen-2xl px-4 py-3 flex flex-col gap-3">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-base text-apl-yellow hover:text-apl-orange hover:underline underline-offset-4 transition-colors py-1"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-icon-open");
  const closeIcon = document.getElementById("menu-icon-close");

  menuBtn?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("hidden") === false;
    openIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
  });
</script>
