---
import { CARD_IMAGES } from "@/lib/data/card-images";
import { CARD_ORACLE } from "@/lib/data/card-oracle";

interface Props {
  name: string;
}

const { name } = Astro.props;
const image = CARD_IMAGES[name];
const oracle = CARD_ORACLE[name];
---

{image ? (
  <span
    class="card-preview-trigger cursor-default underline decoration-dotted decoration-muted-foreground underline-offset-4 hover:text-primary"
    data-card-front={image.front}
    data-card-back={image.back}
    data-card-name={name}
    data-card-oracle={oracle && JSON.stringify(oracle)}
    tabindex="0"
    role="button"
    aria-label={`Preview ${name}`}
  >{name}</span>
) : (
  name
)}
