{/*
  Shared floating preview shown by any element with a data-card-front
  attribute (see CardName.astro). One instance per page, included once in
  the root layout: desktop hovers/focuses a trigger to preview it in a small
  floating box, touch devices tap a trigger to open a near-fullscreen
  overlay instead (a small floating preview isn't a meaningful "zoom in" on
  mobile, especially over cards already shown as images in the visual deck
  view); tapping outside or the close button dismisses it.
*/}
<div id="card-preview-popup" class="card-preview-popup" hidden>
  <button type="button" class="card-preview-close" aria-label="Close preview">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>
  <img class="card-preview-img" data-face="front" alt="" />
  <img class="card-preview-img" data-face="back" alt="" hidden />
</div>

<style>
  .card-preview-popup {
    position: fixed;
    z-index: 100;
    display: flex;
    gap: 0.5rem;
    top: 0;
    left: 0;
  }

  .card-preview-img {
    width: 220px;
    max-width: 42vw;
    aspect-ratio: 63 / 88;
    object-fit: cover;
    border-radius: 4.5% / 3.2%;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.55);
    background: var(--muted);
  }

  .card-preview-close {
    display: none;
  }

  /* Touch devices: near-fullscreen overlay instead of a small floating box. */
  .card-preview-popup.is-fullscreen {
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 2.5rem 1.25rem;
    background: rgb(0 0 0 / 0.8);
  }

  .card-preview-popup.is-fullscreen .card-preview-img {
    width: min(88vw, 420px);
    max-width: none;
  }

  .card-preview-popup.is-fullscreen .card-preview-close {
    display: flex;
    position: absolute;
    top: 1rem;
    right: 1rem;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.15);
    color: white;
    cursor: pointer;
  }
</style>

<script>
  const popup = document.getElementById("card-preview-popup") as HTMLElement;
  const frontImg = popup.querySelector('[data-face="front"]') as HTMLImageElement;
  const backImg = popup.querySelector('[data-face="back"]') as HTMLImageElement;
  const closeBtn = popup.querySelector(".card-preview-close") as HTMLButtonElement;

  const hoverCapable = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  // Set once a trigger is clicked/tapped; keeps the preview open through
  // mouseout so touch taps (and desktop "click to pin") don't auto-dismiss.
  let pinnedTrigger: HTMLElement | null = null;

  function triggerOf(target: EventTarget | null): HTMLElement | null {
    return target instanceof Element ? target.closest<HTMLElement>("[data-card-front]") : null;
  }

  function showPreview(trigger: HTMLElement) {
    const front = trigger.dataset.cardFront;
    const back = trigger.dataset.cardBack;
    if (!front) return;

    frontImg.src = front;
    frontImg.hidden = false;
    if (back) {
      backImg.src = back;
      backImg.hidden = false;
    } else {
      backImg.hidden = true;
      backImg.removeAttribute("src");
    }

    popup.hidden = false;

    if (hoverCapable) {
      popup.classList.remove("is-fullscreen");
      positionPopup(trigger);
    } else {
      popup.classList.add("is-fullscreen");
      popup.style.left = "";
      popup.style.top = "";
    }
  }

  function hidePreview() {
    popup.hidden = true;
    pinnedTrigger = null;
  }

  function positionPopup(trigger: HTMLElement) {
    const rect = trigger.getBoundingClientRect();
    const popupRect = popup.getBoundingClientRect();
    const margin = 12;

    let left = rect.right + margin;
    if (left + popupRect.width > window.innerWidth - margin) {
      left = rect.left - popupRect.width - margin;
    }
    left = Math.min(Math.max(margin, left), Math.max(margin, window.innerWidth - popupRect.width - margin));

    let top = rect.top - (popupRect.height - rect.height) / 2;
    top = Math.min(Math.max(margin, top), Math.max(margin, window.innerHeight - popupRect.height - margin));

    popup.style.left = `${left}px`;
    popup.style.top = `${top}px`;
  }

  closeBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    hidePreview();
  });

  if (hoverCapable) {
    document.addEventListener("mouseover", (e) => {
      const trigger = triggerOf(e.target);
      if (trigger) showPreview(trigger);
    });
    document.addEventListener("mouseout", (e) => {
      const trigger = triggerOf(e.target);
      if (trigger && trigger !== pinnedTrigger) hidePreview();
    });
    document.addEventListener("focusin", (e) => {
      const trigger = triggerOf(e.target);
      if (trigger) showPreview(trigger);
    });
    document.addEventListener("focusout", (e) => {
      const trigger = triggerOf(e.target);
      if (trigger && trigger !== pinnedTrigger) hidePreview();
    });
  }

  document.addEventListener("click", (e) => {
    const trigger = triggerOf(e.target);
    if (trigger) {
      if (pinnedTrigger === trigger) {
        hidePreview();
      } else {
        pinnedTrigger = trigger;
        showPreview(trigger);
      }
      e.stopPropagation();
      return;
    }
    if (!popup.hidden) hidePreview();
  });

  if (hoverCapable) {
    window.addEventListener(
      "scroll",
      () => {
        if (pinnedTrigger) positionPopup(pinnedTrigger);
      },
      true,
    );
    window.addEventListener("resize", () => {
      if (pinnedTrigger) positionPopup(pinnedTrigger);
    });
  }
</script>
