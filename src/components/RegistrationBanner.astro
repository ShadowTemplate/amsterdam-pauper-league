---
import { EVENTS } from "@/lib/data-layer";

const nextEvent = EVENTS
  .filter((e) => e.status === "upcoming" && e.registrationUrl)
  .sort((a, b) => b.date.localeCompare(a.date))[0];

const message = nextEvent ? `Registration for ${nextEvent.name} is open — apply now` : null;
---

{
  nextEvent && (
    <a
      href={nextEvent.registrationUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="block w-full overflow-hidden bg-apl-orange text-black border-b border-black/10"
      aria-label={message ?? undefined}
    >
      <div class="flex whitespace-nowrap py-2.5">
        <div class="animate-apl-marquee flex w-max shrink-0 gap-8">
          {Array.from({ length: 16 }).map((_, i) => (
            <span class="text-sm md:text-base font-extrabold uppercase tracking-tight px-4" aria-hidden={i >= 8 ? "true" : undefined}>
              {message} &nbsp;•
            </span>
          ))}
        </div>
      </div>
    </a>
  )
}
