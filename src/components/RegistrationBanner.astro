---
import { EVENTS } from "@/lib/data-layer";
import { formatDate } from "@/lib/utils";

// Soonest upcoming event. If registration is open, link to it; otherwise
// just announce the event (linking to the events list).
const nextEvent = EVENTS
  .filter((e) => e.status === "upcoming")
  .sort((a, b) => a.date.localeCompare(b.date))[0];

// Drop the trailing " – 2027" year suffix for display.
const displayName = nextEvent?.name.replace(/\s+–\s+\d{4}$/, "");
---

{
  nextEvent && (
    <div class="w-full bg-primary/10 border-b border-primary/20">
      <div class="mx-auto max-w-screen-lg px-4 py-2.5 text-sm text-center">
        →{" "}
        {nextEvent.registrationUrl ? (
          <a
            href={nextEvent.registrationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-4 hover:opacity-80 transition"
          >
            Registration for <strong>{displayName}</strong> is open!
          </a>
        ) : (
          <a
            href={`/events/${nextEvent.date.slice(0, 4)}`}
            class="underline underline-offset-4 hover:opacity-80 transition"
          >
            The <strong>{displayName}</strong> is coming on {formatDate(nextEvent.date)}! Registration opens soon.
          </a>
        )}{" "}
        ←
      </div>
    </div>
  )
}
