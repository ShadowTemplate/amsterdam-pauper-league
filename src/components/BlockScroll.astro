---
// Block-by-block scrolling for pages split into .snap-block sections: one
// wheel/trackpad gesture moves to the start of the next (or previous) block.
// Blocks taller than the window scroll normally until their edge is reached.
// Touch and keyboard scrolling are left alone.
//
// Blocks land below the sticky header by honouring the page's
// scroll-padding-top.
//
// The URL's #hash follows the block in view, so a block can be shared or
// reloaded (/players#all). The first block uses the bare URL.
---

<script>
  const blocks = [...document.querySelectorAll<HTMLElement>(".snap-block")];

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || !entry.target.id) continue;
        const bare = location.pathname + location.search;
        const url = entry.target === blocks[0] ? bare : `#${entry.target.id}`;
        if (url !== bare + location.hash) history.replaceState(null, "", url);
      }
    },
    // a block is "in view" once it covers the middle of the window
    { rootMargin: "-50% 0px -50% 0px" },
  );
  blocks.forEach((block) => observer.observe(block));
  const GESTURE_GAP = 250; // ms of wheel silence that ends a gesture (trackpad inertia)
  let animating = false;
  let lastWheel = 0;
  let gestureMoved = false; // the current gesture already moved a block

  const snapPadding = () => parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
  const pageTop = (el: HTMLElement) => el.getBoundingClientRect().top + scrollY;
  const startOf = (el: HTMLElement) => Math.max(0, pageTop(el) - snapPadding());
  const endOf = (el: HTMLElement) => pageTop(el) + el.offsetHeight - innerHeight;

  function currentIndex() {
    let index = 0;
    blocks.forEach((el, i) => {
      if (startOf(el) <= scrollY + 2) index = i;
    });
    return index;
  }

  function goTo(top: number) {
    animating = true;
    const done = () => {
      animating = false;
      clearTimeout(fallback);
    };
    const fallback = setTimeout(done, 1000);
    window.addEventListener("scrollend", done, { once: true });
    window.scrollTo({ top, behavior: "smooth" });
  }

  if (blocks.length > 1) {
    window.addEventListener(
      "wheel",
      (event) => {
        if (event.ctrlKey || Math.abs(event.deltaY) < Math.abs(event.deltaX)) return;
        const now = performance.now();
        const sameGesture = now - lastWheel < GESTURE_GAP;
        lastWheel = now;
        if (!sameGesture) gestureMoved = false;
        if (animating || gestureMoved) {
          // swallow the rest of a gesture that already moved a block
          event.preventDefault();
          return;
        }
        const i = currentIndex();
        const block = blocks[i];
        let target: number | null = null;
        if (event.deltaY > 0 && i < blocks.length - 1 && scrollY >= endOf(block) - 2) {
          target = startOf(blocks[i + 1]);
        } else if (event.deltaY < 0 && i > 0 && scrollY <= startOf(block) + 2) {
          const prev = blocks[i - 1];
          // back to the first block means back to the very top (banner included)
          target = i === 1 ? 0 : Math.max(startOf(prev), endOf(prev));
        }
        if (target !== null) {
          event.preventDefault();
          gestureMoved = true;
          goTo(target);
        }
      },
      { passive: false },
    );
  }
</script>
