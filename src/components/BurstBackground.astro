---
// The APL burst (wavy rays + falling figure) as a fixed layer behind the page,
// centred in the window. Rays extended to fill any screen shape, see
// tools/landing-burst/.
//
// By default it shows faintly, as a background pattern, centred in the window
// below the sticky header: the same frame on every page (ArchetypeBurst uses
// it too), so the background doesn't jump when moving between pages.
// With `vivid` it starts in full colour over the whole window; LandingHero
// uses that and, on scroll down, fades it to the same faint level (each
// layer's --faded-opacity) while easing it into the shared frame.
import Rays from "@/assets/landing-rays.svg";
import Figure from "@/assets/landing-figure.svg";

interface Props {
  vivid?: boolean;
}

const { vivid = false } = Astro.props;
---

<div class:list={["burst-layer burst-rays", { vivid }]} aria-hidden="true">
  <Rays class="burst-art" />
</div>
<div class:list={["burst-layer burst-figure", { vivid }]} aria-hidden="true">
  <Figure class="burst-art" />
</div>

<style>
  /* Behind the page content (negative z-index), the figure above the rays. */
  .burst-layer {
    position: fixed;
    left: 0;
    right: 0;
    top: 3.5rem; /* below the sticky header */
    height: calc(100vh - 3.5rem);
    height: calc(100dvh - 3.5rem);
    pointer-events: none;
    opacity: var(--faded-opacity);
    will-change: opacity;
  }

  .burst-layer.vivid {
    top: 0;
    height: 100vh;
    height: 100dvh;
    opacity: 1;
  }

  .burst-rays {
    --faded-opacity: 0.12;
    z-index: -2;
  }

  .burst-figure {
    --faded-opacity: 0.25;
    z-index: -1;
  }

  .burst-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
