---
import Layout from "@/layouts/Layout.astro";
import { EVENTS, getLeagueSeason } from "@/lib/mock-data";
import { formatDate } from "@/lib/utils";
import { CURRENT_SEASON_YEAR, AVAILABLE_YEARS } from "@/lib/current-season";

export function getStaticPaths() {
  return AVAILABLE_YEARS.map((year) => ({ params: { year: String(year) } }));
}

const { year } = Astro.params;
const currentYear = parseInt(year);

const season = getLeagueSeason(currentYear) ?? getLeagueSeason(CURRENT_SEASON_YEAR)!;
const availableYears = AVAILABLE_YEARS;

const nextEvent = EVENTS.filter((e) => e.status === "upcoming")
  .sort((a, b) => a.date.localeCompare(b.date))[0];

const pastEventsForYear = EVENTS.filter(
  (e) => e.status === "past" && e.date.startsWith(String(currentYear))
).sort((a, b) => b.date.localeCompare(a.date));
const recentEvents = pastEventsForYear.slice(0, 2);

const { stats } = season;
---

<Layout title="Tournaments – Amsterdam Pauper League">
  <div class="container mx-auto max-w-screen-lg px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Seasons</h1>

    <!-- Year switcher -->
    <div class="flex gap-4 mb-6">
      {availableYears.map((y) => (
        <a
          href={`/seasons/${y}`}
          class={currentYear === y
            ? "font-bold underline underline-offset-4"
            : "text-muted-foreground hover:underline underline-offset-4"}
        >
          {y}
        </a>
      ))}
    </div>

    {currentYear === CURRENT_SEASON_YEAR && (
      <p class="text-sm text-muted-foreground mb-6 italic">The first 3 events of this season were organised by the Dutch Pauper League and are displayed here for historical relevance.</p>
    )}

    {currentYear < CURRENT_SEASON_YEAR && (
      <p class="text-sm text-muted-foreground mb-6 italic">All the events of this season were organised by the Dutch Pauper League and are displayed here for historical relevance.</p>
    )}

    <!-- Next event (only for the current season) -->
    {currentYear === CURRENT_SEASON_YEAR && nextEvent && (
      <section class="mb-8">
        <h2 class="text-xl font-semibold mb-4">Next Event</h2>
        <ul class="border border-border divide-y divide-border">
          <li class="flex items-center justify-between py-3 px-4">
            <div>
              <div class="font-medium">{nextEvent.name}</div>
              <div class="text-sm text-muted-foreground">
                {formatDate(nextEvent.date)} @ {nextEvent.venue}
              </div>
            </div>
            {nextEvent.registrationUrl ? (
              <a
                href={nextEvent.registrationUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm rounded-lg px-3 py-1 bg-primary text-primary-foreground hover:opacity-90 transition-colors"
              >
                Register
              </a>
            ) : (
              <span class="text-sm border border-border rounded-lg px-3 py-1 text-muted-foreground">
                Coming Soon
              </span>
            )}
          </li>
        </ul>
        <div class="mt-2">
          <a href={`/events/${year}`} class="text-sm hover:underline underline-offset-4 text-primary">
            View calendar →
          </a>
        </div>
      </section>
    )}

    <!-- Recent events -->
    {recentEvents.length > 0 && (
      <section class="mb-8">
        <h2 class="text-xl font-semibold mb-4">Past Events</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {recentEvents.map((event) => (
            <a href={`/events/${event.slug}`} class="block border border-border p-4 hover:bg-muted/50 transition-colors">
              <div class="font-semibold mb-1">{event.name}</div>
              <div class="text-sm text-muted-foreground mb-3">
                {formatDate(event.date)} @ {event.venue}
              </div>
              <div class="flex items-center gap-4 text-sm text-muted-foreground">
                {event.winner && (
                  <span class="flex items-center gap-1">
                    <svg class="h-[14px] w-[14px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
                    </svg>
                    {event.winner}
                  </span>
                )}
                {event.playerCount != null && (
                  <span class="flex items-center gap-1">
                    <svg class="h-[14px] w-[14px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    {event.playerCount} players
                  </span>
                )}
              </div>
            </a>
          ))}
        </div>
        <div class="mt-2">
          <a href={`/events/${year}`} class="text-sm hover:underline underline-offset-4 text-primary">
            View all →
          </a>
        </div>
      </section>
    )}

    <!-- Stats + Progress -->
    <div class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-4 mb-8 items-stretch">

      <!-- Left: stacked stat cards -->
      <div class="flex flex-col gap-4">
        <div class="flex-1 border border-border p-4 text-center w-full sm:w-40 flex flex-col items-center justify-center">
          <div class="text-3xl font-bold font-mono" data-count={stats.uniquePlayers}>{stats.uniquePlayers}</div>
          <div class="text-sm text-muted-foreground">unique players</div>
        </div>
        <div class="flex-1 border border-border p-4 text-center w-full sm:w-40 flex flex-col items-center justify-center">
          <div class="text-3xl font-bold font-mono" data-count={stats.averagePlayers}>{stats.averagePlayers}</div>
          <div class="text-sm text-muted-foreground">average players</div>
        </div>
      </div>

      <!-- Right: progress bars -->
      <div class="border border-border p-6 flex flex-col justify-center gap-8">

        <!-- Legs played -->
        <div>
          <p class="font-medium text-sm mb-3">Legs played</p>
          <div class="flex h-8 rounded-sm border border-border overflow-hidden divide-x divide-border" data-bar={stats.eventsCompleted} data-bar-dur="300">
            {Array.from({ length: stats.totalEvents }, (_, i) => (
              <div class="relative flex-1 bg-muted">
                <div class="bar-seg-fill absolute inset-y-0 left-0 bg-green-700" style="width:0%"></div>
                <div class="bar-seg-num absolute inset-0 flex items-center justify-center text-xs font-mono font-bold text-muted-foreground">
                  {i + 1}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Byes and flight tickets unlocked -->
        <div>
          <p class="font-medium text-sm mb-3">Byes and flight tickets unlocked</p>
          <div class="flex h-8 rounded-sm border border-border overflow-hidden divide-x divide-border" data-bar={stats.byesUnlocked} data-bar-dur="700">
            {[1, 2, 3].map((n) => (
              <div class="relative flex-1 bg-muted">
                <div class="bar-seg-fill absolute inset-y-0 left-0 bg-green-700" style="width:0%"></div>
                <div class="bar-seg-num absolute inset-0 flex items-center justify-center text-xs font-mono font-bold text-muted-foreground">
                  {n}
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

    <!-- Standings table -->
    <h2 class="text-xl font-semibold mb-4">Standings</h2>
    <div class="w-full overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr>
            <th class="text-left font-medium text-muted-foreground border-b border-border py-3 px-4 w-12">
              #
            </th>
            <th class="text-left font-medium text-muted-foreground border-b border-border py-3 px-4">
              Player
            </th>
            <th class="text-left font-medium text-muted-foreground border-b border-border py-3 px-4">
              Points
            </th>
          </tr>
        </thead>
        <tbody>
          {season.standings.map((s) => (
            <tr class="hover:bg-muted/50">
              <td class="py-3 px-4 border-b border-border font-mono">{s.position}</td>
              <td class="py-3 px-4 border-b border-border">
                <span class="flex items-center gap-2">
                  <a href={`/players/${s.playerSlug}`} class="hover:underline underline-offset-4 text-foreground">
                    {s.player}
                  </a>
                  {currentYear < CURRENT_SEASON_YEAR && s.position === 1 && (
                    <svg class="h-4 w-4 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
                    </svg>
                  )}
                  {s.flight && (
                    <svg class="h-[18px] w-[18px] text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path transform="rotate(30, 12, 12)" d="M12 3 L10 11 L2 14 L10 13 L10 20 L8 22 L12 21 L16 22 L14 20 L14 13 L22 14 L14 11 Z" />
                    </svg>
                  )}
                  {s.bye && (
                    <svg class="h-4 w-4 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <g transform="translate(4,0)">
                        <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0" /><path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2" /><path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8" /><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
                      </g>
                      <path d="M5 3 Q3 6 5 9" stroke-width="1.5" /><path d="M3 1 Q1 4.5 3 8" stroke-width="1.5" />
                    </svg>
                  )}
                </span>
              </td>
              <td class="py-3 px-4 border-b border-border font-mono">{s.points}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Legend -->
    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground">
      <span class="flex items-center gap-2">
        <svg class="h-4 w-auto shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="3 1 18 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
        </svg>
        APL Champion
      </span>
      <span class="flex items-center gap-2">
        <svg class="h-4 w-auto shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="1 3 20 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path transform="rotate(30, 12, 12)" d="M12 3 L10 11 L2 14 L10 13 L10 20 L8 22 L12 21 L16 22 L14 20 L14 13 L22 14 L14 11 Z" />
        </svg>
        Paupergeddon travel allowance
      </span>
      <span class="flex items-center gap-2">
        <svg class="h-4 w-auto shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="1 1 25 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <g transform="translate(4,0)">
            <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0" /><path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2" /><path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8" /><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
          </g>
          <path d="M5 3 Q3 6 5 9" stroke-width="1.5" /><path d="M3 1 Q1 4.5 3 8" stroke-width="1.5" />
        </svg>
        Paupergeddon bye
      </span>
    </div>
  </div>
</Layout>

<script>
  function animateCount(el: HTMLElement) {
    const target = parseFloat(el.dataset.count ?? "0");
    const isFloat = String(target).includes(".");
    const decimals = isFloat ? (String(target).split(".")[1]?.length ?? 1) : 0;
    const duration = 1200;
    const start = performance.now();

    function tick(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = target * eased;
      el.textContent = isFloat ? current.toFixed(decimals) : String(Math.round(current));
      if (progress < 1) requestAnimationFrame(tick);
      else el.textContent = isFloat ? target.toFixed(decimals) : String(target);
    }

    requestAnimationFrame(tick);
  }

  function animateBar(bar: HTMLElement) {
    const filled = parseInt(bar.dataset.bar ?? "0");
    const dur = parseInt(bar.dataset.barDur ?? "350");
    const segments = bar.querySelectorAll<HTMLElement>(":scope > .relative");
    segments.forEach((seg, i) => {
      if (i >= filled) return;
      const fill = seg.querySelector<HTMLElement>(".bar-seg-fill");
      const num = seg.querySelector<HTMLElement>(".bar-seg-num");
      if (!fill || !num) return;
      setTimeout(() => {
        fill.style.transition = `width ${dur}ms linear`;
        fill.style.width = "100%";
        setTimeout(() => {
          num.classList.remove("text-muted-foreground");
          num.classList.add("text-white");
        }, dur * 0.5);
      }, i * dur);
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const el = entry.target as HTMLElement;
        if (entry.isIntersecting) {
          if (el.dataset.count !== undefined) animateCount(el);
          if (el.dataset.bar !== undefined) animateBar(el);
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.5 }
  );

  document.querySelectorAll<HTMLElement>("[data-count], [data-bar]").forEach((el) => observer.observe(el));
</script>
