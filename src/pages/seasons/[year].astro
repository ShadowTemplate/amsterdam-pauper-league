---
import Layout from "@/layouts/Layout.astro";
import { getLeagueSeason, getSeasonMeta } from "@/lib/data-layer";
import { CURRENT_SEASON_YEAR, AVAILABLE_YEARS } from "@/lib/current-season";
import MetagamePie from "@/components/MetagamePie.astro";
import BurstBackground from "@/components/BurstBackground.astro";
import FlowAroundFigure from "@/components/FlowAroundFigure.astro";
import SplitButtons from "@/components/SplitButtons.astro";
import BlockScroll from "@/components/BlockScroll.astro";

export function getStaticPaths() {
  return AVAILABLE_YEARS.map((year) => ({ params: { year: String(year) } }));
}

const { year } = Astro.params;
const currentYear = parseInt(year);

const season = getLeagueSeason(currentYear) ?? getLeagueSeason(CURRENT_SEASON_YEAR)!;
const availableYears = AVAILABLE_YEARS;
const seasonMeta = getSeasonMeta(currentYear);

const { stats } = season;
---

<Layout title="Tournaments – Amsterdam Pauper League">
  <BurstBackground />
  <main>
    <!-- Season overview: one window high below the header. The title, year
         selection and the season's statistics are on the left; Events and
         Standings fill the right half (same buttons as the homepage) -->
    <div id="overview" class="season-overview snap-block grid grid-cols-1 md:grid-cols-2">
      <section class="flex flex-col justify-center gap-8 px-4 py-8 md:px-10" aria-label="Season statistics">
        <div class="flex flex-wrap items-baseline gap-x-8 gap-y-2">
          <h1 class="heading-display text-5xl sm:text-6xl">Seasons</h1>
          <!-- Year switcher -->
          <nav class="flex gap-5" aria-label="Season">
            {availableYears.map((y) => (
              <a
                href={`/seasons/${y}`}
                aria-current={currentYear === y ? "page" : undefined}
                class:list={[
                  "heading-display text-2xl sm:text-3xl transition-colors",
                  currentYear === y
                    ? "text-[#ff4e00]"
                    : "text-muted-foreground hover:text-foreground",
                ]}
              >
                {y}
              </a>
            ))}
          </nav>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="stat-card">
            <div class="heading-display text-5xl sm:text-6xl" data-count={stats.uniquePlayers}>{stats.uniquePlayers}</div>
            <div class="text-sm text-muted-foreground">unique players</div>
          </div>
          <div class="stat-card">
            <div class="heading-display text-5xl sm:text-6xl" data-count={stats.averagePlayers}>{stats.averagePlayers}</div>
            <div class="text-sm text-muted-foreground">average players</div>
          </div>
        </div>

        <!-- Legs played -->
        <div>
          <p class="heading-display text-xl mb-3">Legs played</p>
          <div class="season-bar" data-bar={stats.eventsCompleted} data-bar-dur="300">
            {Array.from({ length: stats.totalEvents }, (_, i) => (
              <div class="relative flex-1">
                <div class="bar-seg-fill absolute inset-y-0 left-0" style="width:0%"></div>
                <div class="bar-seg-num absolute inset-0 flex items-center justify-center text-xs font-mono font-bold text-muted-foreground">
                  {i + 1}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Byes and flight tickets unlocked -->
        <div>
          <p class="heading-display text-xl mb-3">Byes and flight tickets unlocked</p>
          <div class="season-bar" data-bar={stats.byesUnlocked} data-bar-dur="700">
            {[1, 2, 3].map((n) => (
              <div class="relative flex-1">
                <div class="bar-seg-fill absolute inset-y-0 left-0" style="width:0%"></div>
                <div class="bar-seg-num absolute inset-0 flex items-center justify-center text-xs font-mono font-bold text-muted-foreground">
                  {n}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <SplitButtons
        label="Explore the season"
        links={[
          { href: `/events/${year}`, label: "Events" },
          { href: "#meta", label: "Meta" },
          { href: "#standings", label: "Standings" },
        ]}
      />
    </div>

    <!-- Season metagame -->
    <section id="meta" class="snap-block mx-auto w-full max-w-screen-lg px-4 py-12">
      <h2 class="heading-display text-4xl sm:text-5xl mb-6">Meta</h2>
      <MetagamePie meta={seasonMeta} title="" glass />
    </section>

    <!-- Season standings -->
    <section id="standings" class="snap-block mx-auto w-full max-w-screen-lg px-4 py-12">
      <h2 class="heading-display text-4xl sm:text-5xl mb-6">Standings</h2>
      <!-- see-through panel, like the "All players" list -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 items-start rounded-xl border border-border bg-background/70 p-2 sm:p-4 backdrop-blur-sm">
        {[
          season.standings.slice(0, Math.ceil(season.standings.length / 2)),
          season.standings.slice(Math.ceil(season.standings.length / 2)),
        ].map((half, i) => (
        <div class="w-full overflow-x-auto">
        <table class="w-full text-sm border-collapse table-fixed">
          <colgroup>
            <col class="w-12" />
            <col />
            <col class="w-24" />
          </colgroup>
          <thead class={i > 0 ? "hidden md:table-header-group" : ""}>
            <tr>
              <th class="text-left font-medium text-muted-foreground border-b border-border py-3 px-4 w-12">
                #
              </th>
              <th class="text-left font-medium text-muted-foreground border-b border-border py-3 px-4">
                Player
              </th>
              <th class="text-left font-medium text-muted-foreground border-b border-border py-3 px-4 w-24">
                Points
              </th>
            </tr>
          </thead>
          <tbody>
            {half.map((s) => (
              <tr class="hover:bg-muted/50">
                <td class="py-3 px-4 border-b border-border font-mono">{s.position}</td>
                <td class="py-3 px-4 border-b border-border">
                  <span class="flex items-center gap-2">
                    {currentYear === CURRENT_SEASON_YEAR && (
                      s.positionChange === undefined ? (
                        <span class="text-[10px] font-bold tracking-wider text-yellow-600 dark:text-yellow-400 shrink-0" title="New player in the season">NEW</span>
                      ) : s.positionChange > 0 ? (
                        <svg class="h-4 w-4 text-green-600 dark:text-green-400 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" title={`Up ${s.positionChange} since last leg`}>
                          <path d="m18 15-6-6-6 6" />
                        </svg>
                      ) : s.positionChange < 0 ? (
                        <svg class="h-4 w-4 text-red-600 dark:text-red-400 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" title={`Down ${-s.positionChange} since last leg`}>
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      ) : (
                        <svg class="h-4 w-4 text-muted-foreground shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" title="Unchanged since last leg">
                          <path d="m9 18 6-6-6-6" />
                        </svg>
                      )
                    )}
                    <a href={`/players/${s.playerSlug}`} class="hover:underline underline-offset-4 text-foreground">
                      {s.player}
                    </a>
                    {currentYear < CURRENT_SEASON_YEAR && s.position === 1 && (
                      <svg class="h-4 w-4 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
                      </svg>
                    )}
                    {s.flight && (
                      <svg class="h-[18px] w-[18px] text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path transform="rotate(30, 12, 12)" d="M12 3 L10 11 L2 14 L10 13 L10 20 L8 22 L12 21 L16 22 L14 20 L14 13 L22 14 L14 11 Z" />
                      </svg>
                    )}
                    {s.bye && (
                      <svg class="h-4 w-4 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <g transform="translate(4,0)">
                          <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0" /><path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2" /><path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8" /><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
                        </g>
                        <path d="M5 3 Q3 6 5 9" stroke-width="1.5" /><path d="M3 1 Q1 4.5 3 8" stroke-width="1.5" />
                      </svg>
                    )}
                  </span>
                </td>
                <td class="py-3 px-4 border-b border-border font-mono">{s.points}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
        ))}
      </div>

      <!-- Legend -->
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground">
        {currentYear === CURRENT_SEASON_YEAR && (
          <span class="flex items-center gap-2">
            <span class="text-[10px] font-bold tracking-wider text-yellow-600 dark:text-yellow-400">NEW</span>
            New player in the season
          </span>
        )}
        <span class="flex items-center gap-2">
          <svg class="h-4 w-auto shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="3 1 18 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
          </svg>
          APL Champion
        </span>
        <span class="flex items-center gap-2">
          <svg class="h-4 w-auto shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="1 3 20 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path transform="rotate(30, 12, 12)" d="M12 3 L10 11 L2 14 L10 13 L10 20 L8 22 L12 21 L16 22 L14 20 L14 13 L22 14 L14 11 Z" />
          </svg>
          Paupergeddon travel allowance
        </span>
        <span class="flex items-center gap-2">
          <svg class="h-4 w-auto shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="1 1 25 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <g transform="translate(4,0)">
              <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0" /><path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2" /><path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8" /><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
            </g>
            <path d="M5 3 Q3 6 5 9" stroke-width="1.5" /><path d="M3 1 Q1 4.5 3 8" stroke-width="1.5" />
          </svg>
          Paupergeddon bye
        </span>
      </div>

      {currentYear === CURRENT_SEASON_YEAR && (
        <p class="text-sm text-muted-foreground mt-6 italic">The first 3 events of this season were organised by the Dutch Pauper League and are displayed here for historical relevance.</p>
      )}

      {currentYear < CURRENT_SEASON_YEAR && (
        <p class="text-sm text-muted-foreground mt-6 italic">All the events of this season were organised by the Dutch Pauper League and are displayed here for historical relevance.</p>
      )}
    </section>
  </main>
  <!-- after the page content: its script runs in place and needs the buttons -->
  <FlowAroundFigure />
  <!-- one wheel gesture moves between overview, meta and standings -->
  <BlockScroll />
</Layout>

<style>
  .season-overview {
    min-height: calc(100vh - 3.5rem - var(--banner-h, 0px));
    min-height: calc(100dvh - 3.5rem - var(--banner-h, 0px));
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 1.25rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: rgb(17 34 54 / 0.7);
    backdrop-filter: blur(4px);
    text-align: center;
  }

  /* segmented progress bars, filled in brand purple */
  .season-bar {
    display: flex;
    height: 2.25rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: rgb(17 34 54 / 0.7);
  }

  .season-bar > * + * {
    border-left: 1px solid var(--border);
  }

  .season-bar :global(.bar-seg-fill) {
    background: #a37ac9;
  }

  :global(html) {
    scroll-padding-top: 3.5rem; /* blocks land clear of the sticky header */
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  function animateCount(el: HTMLElement) {
    const target = parseFloat(el.dataset.count ?? "0");
    const isFloat = String(target).includes(".");
    const decimals = isFloat ? (String(target).split(".")[1]?.length ?? 1) : 0;
    const duration = 1200;
    const start = performance.now();

    function tick(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = target * eased;
      el.textContent = isFloat ? current.toFixed(decimals) : String(Math.round(current));
      if (progress < 1) requestAnimationFrame(tick);
      else el.textContent = isFloat ? target.toFixed(decimals) : String(target);
    }

    requestAnimationFrame(tick);
  }

  function animateBar(bar: HTMLElement) {
    const filled = parseInt(bar.dataset.bar ?? "0");
    const dur = parseInt(bar.dataset.barDur ?? "350");
    const segments = bar.querySelectorAll<HTMLElement>(":scope > .relative");
    segments.forEach((seg, i) => {
      if (i >= filled) return;
      const fill = seg.querySelector<HTMLElement>(".bar-seg-fill");
      const num = seg.querySelector<HTMLElement>(".bar-seg-num");
      if (!fill || !num) return;
      setTimeout(() => {
        fill.style.transition = `width ${dur}ms linear`;
        fill.style.width = "100%";
        setTimeout(() => {
          num.classList.remove("text-muted-foreground");
          num.classList.add("text-[#012031]");
        }, dur * 0.5);
      }, i * dur);
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const el = entry.target as HTMLElement;
        if (entry.isIntersecting) {
          if (el.dataset.count !== undefined) animateCount(el);
          if (el.dataset.bar !== undefined) animateBar(el);
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.5 }
  );

  document.querySelectorAll<HTMLElement>("[data-count], [data-bar]").forEach((el) => observer.observe(el));
</script>
