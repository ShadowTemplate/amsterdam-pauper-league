---
import Layout from "@/layouts/Layout.astro";
import PlayerSearch from "@/components/PlayerSearch.astro";
import { PLAYERS } from "@/lib/mock-data";

const players = PLAYERS;
---

<Layout title="Players – Amsterdam Pauper League">
  <div class="container mx-auto max-w-screen-lg px-4 py-8">
    <h1 class="text-3xl font-bold mb-2">Players</h1>

    <p class="text-sm text-muted-foreground mb-6">
      <span class="font-mono font-semibold text-foreground">{players.length}</span>{" "}
      players in the league
    </p>

    <PlayerSearch players={players} />
  </div>
</Layout>
