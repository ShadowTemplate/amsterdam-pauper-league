---
import Layout from "@/layouts/Layout.astro";
import PlayerSearch from "@/components/PlayerSearch.astro";
import { PLAYERS } from "@/lib/data-layer";

const players = PLAYERS;
---

<Layout title="Players – Amsterdam Pauper League">
  <div class="container mx-auto max-w-6xl px-6 py-6">
    <h1 class="heading-display text-4xl md:text-5xl mb-4">Players</h1>

    <span class="inline-flex items-center gap-2 rounded-full bg-apl-orange text-apl-yellow px-4 py-1.5 text-sm font-bold mb-6">
      <span class="font-mono">{players.length}</span> players in the league
    </span>

    <PlayerSearch players={players} />
  </div>
</Layout>
