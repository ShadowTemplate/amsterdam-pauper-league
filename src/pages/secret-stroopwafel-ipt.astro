---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Stroopwafel IPT – Amsterdam Pauper League">
  <main class="flex-1">
    <!-- Hero -->
    <section class="border-b border-border bg-muted/40">
      <div class="container mx-auto max-w-screen-lg px-4 py-16 md:py-24 text-center space-y-3">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
          Special Event
        </p>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tighter">
          Stroopwafel IPT
        </h1>
        <p class="text-2xl font-mono text-muted-foreground">17.01.2026</p>
        <p class="text-muted-foreground">
          Saturday, 10:00 &nbsp;|&nbsp; Stayokay Oost &nbsp;|&nbsp; Amsterdam
        </p>
      </div>
    </section>

    <!-- Thank-you banner -->
    <div class="border-b border-border bg-primary/10">
      <div class="container mx-auto max-w-screen-lg px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">
        <p class="font-medium text-center sm:text-left">
          Thank you to everyone who joined us for this special event!
        </p>
        <a
          href="/events/2026-01-17"
          class="shrink-0 bg-primary text-primary-foreground px-4 py-1.5 font-medium rounded-lg hover:opacity-90 transition text-sm"
        >
          View results
        </a>
      </div>
    </div>

    <div class="container mx-auto max-w-screen-lg px-4 py-12 space-y-16">

      <!-- About -->
      <section id="about" class="scroll-mt-20 space-y-4">
        <h2 class="text-2xl font-bold tracking-tighter">About</h2>
        <div class="text-muted-foreground leading-relaxed space-y-3">
          <p>
            The Stroopwafel IPT (International Pauper Tournament) is a
            one-day competitive Pauper Magic: The Gathering™ event organised
            by the Amsterdam Pauper League in Amsterdam. It is part of the{" "}
            <strong class="text-foreground">North Sea Tour</strong> — a
            collaboration between the Amsterdam Pauper League, the London Pauper
            League, and Lega Pauper Lipsia, bringing three IPTs across three
            countries to the European Pauper scene.
          </p>
          <p>
            Format: <strong class="text-foreground">Pauper</strong> &nbsp;|&nbsp;
            REL: <strong class="text-foreground">Competitive</strong> &nbsp;|&nbsp;
            Judge team on site
          </p>
        </div>
      </section>

      <!-- Registration & Refunds -->
      <section id="registration" class="scroll-mt-20 space-y-4">
        <h2 class="text-2xl font-bold tracking-tighter">Registration &amp; Refunds</h2>
        <div class="text-muted-foreground leading-relaxed space-y-3">
          <p>
            Registration was handled via{" "}
            <a
              href="https://topdeck.gg"
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-4 hover:text-foreground transition-colors"
            >
              TopDeck.gg
            </a>
            . Entry fee: <strong class="text-foreground">€50</strong> per
            player (includes tournament entry, buffet lunch, and a 15% hotel
            discount at Stayokay Oost).
          </p>
          <div>
            <p class="font-medium text-foreground mb-1">Refund policy:</p>
            <ul class="list-disc pl-6 space-y-1">
              <li>Full refund if cancellation on or before 4 January 2026.</li>
              <li>No refund for cancellations on or after 5 January 2026.</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Tournament Structure & Schedule -->
      <section id="structure" class="scroll-mt-20 space-y-4">
        <h2 class="text-2xl font-bold tracking-tighter">
          Tournament Structure &amp; Schedule
        </h2>
        <div class="text-muted-foreground leading-relaxed space-y-3">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="rounded-lg border border-border p-4 space-y-2">
              <p class="font-medium text-foreground text-sm uppercase tracking-wide">
                Rounds
              </p>
              <ul class="text-sm space-y-1">
                <li>33–64 players → 6 Swiss rounds</li>
                <li>65–128 players → 7 Swiss rounds</li>
                <li>Round time: 50 minutes each</li>
              </ul>
            </div>
            <div class="rounded-lg border border-border p-4 space-y-2">
              <p class="font-medium text-foreground text-sm uppercase tracking-wide">
                Schedule
              </p>
              <ul class="text-sm space-y-1">
                <li>09:00 – Doors open</li>
                <li>10:00 – Round 1 begins</li>
                <li>~20:00–21:00 – Event ends</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Venue -->
      <section id="venue" class="scroll-mt-20 space-y-4">
        <h2 class="text-2xl font-bold tracking-tighter">
          Venue, Travel &amp; Accommodation
        </h2>
        <div class="text-muted-foreground leading-relaxed space-y-3">
          <p>
            <strong class="text-foreground">
              Stayokay Hostel – Amsterdam Oost
            </strong>
            <br />
            Timorplein 21, Amsterdam
          </p>
          <p>
            Stayokay Oost is conveniently located in Amsterdam's east
            district, easily reachable by public transport from Amsterdam
            Centraal or Amstel station. Attendees received a{" "}
            <strong class="text-foreground">15% discount</strong> on
            accommodation at the venue hostel.
          </p>
        </div>
      </section>

      <!-- What Your Ticket Includes -->
      <section id="ticket" class="scroll-mt-20 space-y-4">
        <h2 class="text-2xl font-bold tracking-tighter">
          What Your Ticket Includes
        </h2>
        <ul class="list-disc pl-6 text-muted-foreground leading-relaxed space-y-1">
          <li>Tournament entry</li>
          <li>Buffet lunch on the day</li>
          <li>15% discount on Stayokay Oost accommodation</li>
        </ul>
      </section>

      <!-- Decklists -->
      <section id="decklists" class="scroll-mt-20 space-y-4">
        <h2 class="text-2xl font-bold tracking-tighter">
          Decklists, Rules &amp; Coverage
        </h2>
        <div class="text-muted-foreground leading-relaxed space-y-3">
          <p>
            Decklists were required to be submitted via TopDeck or Moxfield
            before the start of the event. As a Competitive REL event, the
            Magic: The Gathering Comprehensive Rules and Infraction Procedure
            Guide (IPG) were in full effect.
          </p>
          <p>
            A judge team was on site throughout the day to ensure fair play
            and answer rules questions.
          </p>
        </div>
      </section>

      <!-- Prizes -->
      <section id="prizes" class="scroll-mt-20 space-y-4">
        <h2 class="text-2xl font-bold tracking-tighter">
          Prizes, Points &amp; Paupergeddon Bye
        </h2>
        <div class="text-muted-foreground leading-relaxed space-y-3">
          <p>
            The Stroopwafel IPT offered a guaranteed prize pool of{" "}
            <strong class="text-foreground">€1,000</strong>, scaling up
            to <strong class="text-foreground">€3,000</strong> with 128
            players. The winner also earned{" "}
            <strong class="text-foreground">
              round-trip flights to Lucca
            </strong>{" "}
            for Paupergeddon.
          </p>
          <p>
            APL league points were also awarded based on final standing,
            contributing to the 2026 season standings.
          </p>
        </div>
      </section>

      <!-- North Sea Tour -->
      <section id="north-sea-tour" class="scroll-mt-20 space-y-4">
        <h2 class="text-2xl font-bold tracking-tighter">North Sea Tour</h2>
        <div class="text-muted-foreground leading-relaxed space-y-3">
          <p>
            The Stroopwafel IPT is one of three events in the{" "}
            <strong class="text-foreground">North Sea Tour</strong>, a
            collaboration between:
          </p>
          <ul class="list-disc pl-6 space-y-1">
            <li>
              <strong class="text-foreground">Amsterdam Pauper League</strong>{" "}
              (Netherlands)
            </li>
            <li>
              <strong class="text-foreground">London Pauper League</strong>{" "}
              (United Kingdom)
            </li>
            <li>
              <strong class="text-foreground">Lega Pauper Lipsia</strong>{" "}
              (Germany)
            </li>
          </ul>
          <p>
            The North Sea Tour brings three competitive IPTs across three
            countries, providing European Pauper players with more
            opportunities to compete at an international level.
          </p>
        </div>
      </section>

      <!-- Sponsors -->
      <section id="sponsors" class="scroll-mt-20 space-y-4">
        <h2 class="text-2xl font-bold tracking-tighter">Sponsors</h2>
        <p class="text-muted-foreground mb-4">
          The Stroopwafel IPT was made possible by the generous support of
          our sponsors:
        </p>
        <div class="flex flex-wrap gap-3">
          {["Cardmarket", "Pauperformance", "Stayokay", "TopDeck", "Untap"].map(
            (sponsor) => (
              <span class="rounded-md border border-border px-4 py-2 text-sm font-medium">
                {sponsor}
              </span>
            )
          )}
        </div>
      </section>
    </div>
  </main>
</Layout>
