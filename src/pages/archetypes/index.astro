---
import Layout from "@/layouts/Layout.astro";
import ArchetypeSearch from "@/components/ArchetypeSearch.astro";
import { ARCHETYPES } from "@/lib/data-layer";

const archetypes = ARCHETYPES;
const totalDecks = archetypes.reduce((sum, a) => sum + a.count, 0);
---

<Layout title="Archetypes – Amsterdam Pauper League">
  <div class="container mx-auto max-w-6xl px-6 py-6">
    <h1 class="heading-display text-4xl md:text-5xl mb-4">Archetypes</h1>

    <div class="flex flex-wrap gap-3 mb-6">
      <span class="inline-flex items-center gap-2 rounded-full bg-apl-orange text-apl-yellow px-4 py-1.5 text-sm font-bold">
        <span class="font-mono">{totalDecks}</span> total decks
      </span>
      <span class="inline-flex items-center gap-2 rounded-full bg-apl-orange text-apl-yellow px-4 py-1.5 text-sm font-bold">
        <span class="font-mono">{archetypes.length}</span> archetypes
      </span>
    </div>

    <ArchetypeSearch archetypes={archetypes} />
  </div>
</Layout>
