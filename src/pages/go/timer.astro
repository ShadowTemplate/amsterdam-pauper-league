---
import Layout from "@/layouts/Layout.astro";
import { EVENTS } from "@/lib/data-layer";

const TOPDECK_EVENT_PATH = "https://topdeck.gg/event/";

const timerEvents = EVENTS.filter(
  (e) =>
    e.status === "upcoming" &&
    e.registrationUrl?.startsWith(TOPDECK_EVENT_PATH),
).sort((a, b) => b.date.localeCompare(a.date));

const destination = timerEvents[0]?.registrationUrl?.replace(
  "/event/",
  "/timer/",
);
---

{
  destination ? (
    <html lang="en">
      <head>
        <meta charset="UTF-8" />
        <meta http-equiv="refresh" content={`0;url=${destination}`} />
        <meta name="robots" content="noindex" />
        <title>Redirecting to timer…</title>
      </head>
      <body>
        <p>
          Redirecting to <a href={destination}>event timer</a>…
        </p>
        <script define:vars={{ destination }}>
          window.location.replace(destination);
        </script>
      </body>
    </html>
  ) : (
    <Layout title="Timer – Amsterdam Pauper League">
      <main class="flex-1 flex flex-col items-center justify-center py-24 px-4 text-center">
        <h1 class="text-3xl font-bold font-mono mb-4">No active timer</h1>
        <p class="text-muted-foreground mb-8">
          There isn't an upcoming event with a timer right now. Check back soon.
        </p>
        <a
          href="/events"
          class="bg-primary text-primary-foreground px-6 py-2 font-medium rounded-lg hover:opacity-90 transition"
        >
          View events
        </a>
      </main>
    </Layout>
  )
}
