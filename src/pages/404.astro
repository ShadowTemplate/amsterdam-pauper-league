---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 – Amsterdam Pauper League">
  <main class="flex-1 flex flex-col items-center justify-center py-16 px-4 text-center">
    <h1 class="heading-display font-mono text-7xl md:text-8xl text-apl-navy mb-4">404</h1>
    <p class="text-muted-foreground mb-6">This page could not be found.</p>
    <a
      href="/"
      class="bg-apl-orange text-apl-navy px-6 py-2 font-bold rounded-lg hover:opacity-90 transition"
    >
      Go home
    </a>
  </main>
</Layout>
