---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 – Amsterdam Pauper League">
  <main class="flex-1 flex flex-col items-center justify-center py-24 px-4 text-center">
    <h1 class="text-6xl font-bold font-mono mb-4">404</h1>
    <p class="text-muted-foreground mb-8">This page could not be found.</p>
    <a
      href="/"
      class="bg-primary text-primary-foreground px-6 py-2 font-medium rounded-lg hover:opacity-90 transition"
    >
      Go home
    </a>
  </main>
</Layout>
