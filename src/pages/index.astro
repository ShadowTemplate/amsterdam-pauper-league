---
import Layout from "@/layouts/Layout.astro";
import PrizesCard from "@/components/PrizesCard.astro";
import RegistrationBanner from "@/components/RegistrationBanner.astro";
import { getLeagueSeason } from "@/lib/data-layer";
import { CURRENT_SEASON_YEAR } from "@/lib/current-season";

const top16 = (getLeagueSeason(CURRENT_SEASON_YEAR)?.standings ?? []).slice(0, 16);
---

<Layout title="Amsterdam Pauper League">
  <main class="flex-1 bg-white text-neutral-900">
    <RegistrationBanner />

    <!-- Hero -->
    <section class="mx-auto max-w-screen-2xl w-full px-4 pt-6 pb-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:h-[560px]">
        <!-- Left stacked cards -->
        <div class="grid grid-rows-[1fr_auto_auto] md:grid-rows-[2fr_auto_1fr] gap-3">
          <a
            href={`/seasons/${CURRENT_SEASON_YEAR}`}
            class="group relative flex flex-col justify-between rounded-2xl bg-apl-orange text-black p-6 min-h-[160px] hover:opacity-90 transition-opacity"
          >
            <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tight leading-[0.95]">
              Season {CURRENT_SEASON_YEAR}
            </h2>
            <span class="inline-flex items-center gap-1.5 font-bold text-sm uppercase tracking-wide">
              Updated Ranking
              <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            </span>
          </a>

          <a
            href="#prizes"
            class="group flex items-center justify-between rounded-2xl bg-apl-purple text-apl-yellow px-6 py-4 font-black uppercase tracking-tight text-lg hover:opacity-90 transition-opacity"
          >
            Prizes
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          </a>

          <a
            href="/faq"
            class="group relative flex flex-col justify-between rounded-2xl bg-apl-yellow text-apl-orange p-6 min-h-[120px] hover:opacity-90 transition-opacity"
          >
            <h2 class="text-2xl font-black uppercase tracking-tight">Learn More</h2>
            <span class="inline-flex items-center gap-1.5 font-bold text-sm uppercase tracking-wide">
              Our Story
              <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            </span>
          </a>
        </div>

        <!-- Right hero panel: standings -->
        <div class="flex h-full min-h-[420px] flex-col overflow-hidden rounded-2xl bg-apl-purple text-apl-yellow md:min-h-0">
          <div class="flex items-center justify-between px-6 py-4 border-b border-apl-yellow/20">
            <h2 class="font-black uppercase tracking-tight text-lg">
              Season {CURRENT_SEASON_YEAR} Standings
            </h2>
            <a
              href={`/seasons/${CURRENT_SEASON_YEAR}`}
              class="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wide hover:opacity-80 underline-offset-4 transition-opacity"
            >
              View All
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            </a>
          </div>
          <div class="flex flex-1 items-center px-4 py-4">
            <div class="grid w-full grid-cols-1 sm:grid-cols-2 gap-x-6">
              {[top16.slice(0, 8), top16.slice(8, 16)].map((half) => (
                <div>
                  {half.map((s) => (
                    <div class="flex items-center py-2 px-2 border-b border-apl-yellow/20 hover:bg-white/10 text-sm">
                      <span class="font-mono text-apl-yellow/70 w-7 shrink-0 text-center">{s.position}</span>
                      <span class="flex-1 px-2 text-left flex items-center gap-2 min-w-0">
                        {s.positionChange !== undefined && (
                          s.positionChange > 0 ? (
                            <svg class="h-4 w-4 text-white shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" title={`Up ${s.positionChange} since last leg`}>
                              <path d="m18 15-6-6-6 6" />
                            </svg>
                          ) : s.positionChange < 0 ? (
                            <svg class="h-4 w-4 text-apl-yellow/70 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" title={`Down ${-s.positionChange} since last leg`}>
                              <path d="m6 9 6 6 6-6" />
                            </svg>
                          ) : (
                            <svg class="h-4 w-4 text-apl-yellow/40 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" title="Unchanged since last leg">
                              <path d="m9 18 6-6-6-6" />
                            </svg>
                          )
                        )}
                        <a href={`/players/${s.playerSlug}`} class="truncate hover:underline underline-offset-4">
                          {s.player}
                        </a>
                      </span>
                      <span class="font-mono shrink-0">{s.points}</span>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <p class="mx-auto max-w-2xl px-4 pb-10 text-center text-neutral-500 md:text-lg">
      Welcome to the largest Pauper tournament series in the Netherlands! Compete in thrilling monthly events with our fantastic community to win amazing prizes, flight tickets and byes to Paupergeddon.
    </p>

    <div class="mx-auto w-full max-w-3xl border-b border-black/10"></div>

    <!-- Quote -->
    <blockquote class="mx-auto max-w-screen-2xl w-full px-4 pt-0 pb-6 text-center text-neutral-500 italic text-xl">
      "Bottom feeders sometimes rise to the top."
      <footer class="mt-2 text-sm not-italic">— Chittering Rats</footer>
    </blockquote>

    <div class="mx-auto w-full max-w-3xl border-b border-black/10"></div>

    <!-- Prizes -->
    <section id="prizes" class="mx-auto pt-8 pb-6 md:px-6 md:pt-12 max-w-screen-2xl w-full px-4 text-center scroll-mt-20">
      <div class="space-y-4 mb-8">
        <h2 class="text-3xl font-black uppercase tracking-tight sm:text-4xl">
          Prizes
        </h2>
        <p class="text-neutral-500 md:text-xl mx-auto max-w-2xl">
          Leg prizes are determined based on the number of players in each event.<br />
          A portion of the entry fees is used to cover venue costs, judge
          compensation, and travel allowances to Paupergeddon.<br />
          The rest goes directly into the prize pool for that event.
        </p>
      </div>
      <div class="max-w-sm mx-auto">
        <PrizesCard />
      </div>
    </section>

    <!-- Quote -->
    <blockquote class="mx-auto max-w-screen-2xl w-full px-4 pt-0 pb-10 text-center text-neutral-500 italic text-xl">
      "Wake up, my friends! There are deeds to be done and treasures to be won!"
      <footer class="mt-2 text-sm not-italic">— Inspiring Bard</footer>
    </blockquote>
  </main>
</Layout>
