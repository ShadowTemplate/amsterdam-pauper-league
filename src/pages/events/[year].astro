---
import Layout from "@/layouts/Layout.astro";
import BurstBackground from "@/components/BurstBackground.astro";
import { EVENTS } from "@/lib/data-layer";
import { formatDate } from "@/lib/utils";
import { CURRENT_SEASON_YEAR, AVAILABLE_YEARS } from "@/lib/current-season";

export function getStaticPaths() {
  return AVAILABLE_YEARS.map((year) => ({ params: { year: String(year) } }));
}

const { year } = Astro.params;
const currentYear = parseInt(year);
const availableYears = AVAILABLE_YEARS;

const eventsForYear = EVENTS.filter((e) => e.date.startsWith(year)).sort(
  (a, b) => b.date.localeCompare(a.date)
);
---

<Layout title="Events – Amsterdam Pauper League">
  <!-- fixed background: the page content scrolls over it -->
  <BurstBackground />
  <main class="mx-auto w-full max-w-screen-lg px-4 py-12">
    <!-- title and year selection, as on the season page -->
    <div class="mb-6 flex flex-wrap items-baseline gap-x-8 gap-y-2">
      <h1 class="heading-display text-5xl sm:text-6xl">Events</h1>
      <nav class="flex gap-5" aria-label="Season">
        {availableYears.map((y) => (
          <a
            href={`/events/${y}`}
            aria-current={currentYear === y ? "page" : undefined}
            class:list={[
              "heading-display text-2xl sm:text-3xl transition-colors",
              currentYear === y
                ? "text-[#ff4e00]"
                : "text-muted-foreground hover:text-foreground",
            ]}
          >
            {y}
          </a>
        ))}
      </nav>
    </div>

    <!-- Events, newest first: same list style as "All players" -->
    {eventsForYear.length > 0 ? (
      <ol id="events-container" class="rounded-xl border border-border bg-background/70 p-2 sm:p-4 backdrop-blur-sm">
        {eventsForYear.map((event) => {
          const row = (
            <>
              <span class="min-w-0 flex-1">
                <span class="block sm:truncate">{event.name}</span>
                <span class="block sm:truncate text-sm text-muted-foreground">
                  {formatDate(event.date)} @ {event.venue}
                </span>
              </span>
            </>
          );
          return (
            <li>
              {event.status === "upcoming" ? (
                <div class="flex items-center gap-3 border-b border-border px-2 py-2">
                  {row}
                  {event.registrationUrl ? (
                    <a
                      href={event.registrationUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="shrink-0 rounded-lg bg-[#d7cf08] px-3 py-1 text-sm font-medium text-[#012031] hover:opacity-90 transition"
                    >
                      Register
                    </a>
                  ) : (
                    <span class="shrink-0 whitespace-nowrap rounded-lg border border-border px-3 py-1 text-sm text-muted-foreground">
                      Coming Soon
                    </span>
                  )}
                </div>
              ) : (
                <a
                  href={`/events/${event.slug}`}
                  class="flex items-center gap-3 border-b border-border px-2 py-2 hover:bg-muted/50 transition-colors"
                >
                  {row}
                  <span class="flex shrink-0 items-center gap-4 text-sm text-muted-foreground">
                    {event.winner && (
                      <span class="hidden items-center gap-1 sm:flex">
                        <svg class="h-[14px] w-[14px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
                        </svg>
                        {event.winner}
                      </span>
                    )}
                    {event.playerCount != null && (
                      <span class="flex items-center gap-1">
                        <svg class="h-[14px] w-[14px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        {event.playerCount}
                      </span>
                    )}
                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </span>
                </a>
              )}
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="text-muted-foreground">No events found.</p>
    )}

    {currentYear === CURRENT_SEASON_YEAR && (
      <p class="text-sm text-muted-foreground mt-6 italic">The first 3 events of this season were organised by the Dutch Pauper League and are displayed here for historical relevance.</p>
    )}

    {currentYear < CURRENT_SEASON_YEAR && (
      <p class="text-sm text-muted-foreground mt-6 italic">All the events of this season were organised by the Dutch Pauper League and are displayed here for historical relevance.</p>
    )}
  </main>
</Layout>
