---
import Layout from "@/layouts/Layout.astro";
import { getAllDecks } from "@/lib/decks";
import { getEvent, PLAYERS } from "@/lib/data-layer";
import { formatDate } from "@/lib/utils";
import ManaIcons from "@/components/ManaIcons.astro";

const allDecks = getAllDecks();

// Group decks by event
const decksByEvent = allDecks.reduce(
  (acc, deck) => {
    if (!acc[deck.eventSlug]) {
      acc[deck.eventSlug] = [];
    }
    acc[deck.eventSlug].push(deck);
    return acc;
  },
  {} as Record<string, typeof allDecks>
);

// Sort events by date (most recent first)
const sortedEventSlugs = Object.keys(decksByEvent).sort().reverse();

const playerSlugByName = Object.fromEntries(PLAYERS.map((p) => [p.name.toLowerCase(), p.slug]));

const title = "Decks – Amsterdam Pauper League";
---

<Layout title={title}>
  <div class="container mx-auto max-w-screen-lg px-4 py-8">
    <h1 class="text-3xl font-bold mb-2">Decks</h1>
    <p class="text-muted-foreground mb-8">
      Browse all decks played in the league. {allDecks.length} decks across {sortedEventSlugs.length} events.
    </p>

    <!-- Events with Decks -->
    {sortedEventSlugs.map((eventSlug) => {
      const event = getEvent(eventSlug);
      const decks = decksByEvent[eventSlug].slice().sort((a, b) => a.archetype.localeCompare(b.archetype));

      return (
        <section class="mb-12">
          <h2 class="text-2xl font-semibold mb-1">
            {event ? (
              <a href={`/events/${event.slug}`} class="hover:underline underline-offset-4">
                {event.name}
              </a>
            ) : (
              eventSlug
            )}
          </h2>
          {event && (
            <p class="text-sm text-muted-foreground mb-4">
              {formatDate(event.date)} @ {event.venue}
            </p>
          )}

          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 items-start">
            {[decks.slice(0, Math.ceil(decks.length / 2)), decks.slice(Math.ceil(decks.length / 2))].map((half) => (
              <table class="w-full text-sm border-collapse">
                <tbody>
                  {half.map((deck) => {
                    const playerSlug = playerSlugByName[deck.pilotName.toLowerCase()];
                    return (
                      <tr class="hover:bg-muted/50">
                        <td class="py-1.5 pr-3 border-b border-border">
                          <a href={`/decks/${deck.id}`} class="hover:underline underline-offset-4 text-foreground">
                            {deck.archetype}
                          </a>
                          <ManaIcons deck={deck} />
                        </td>
                        <td class="py-1.5 border-b border-border text-muted-foreground">
                          {playerSlug ? (
                            <a href={`/players/${playerSlug}`} class="hover:underline underline-offset-4">
                              {deck.pilotName}
                            </a>
                          ) : (
                            deck.pilotName
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</Layout>
